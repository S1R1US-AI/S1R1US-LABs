# Copy values into the host env. Never commit a filled .env.
# SuperGrok (optional). Server only. Never VITE_.
# XAI_API_KEY=

# Auth / database (platform injects these on deploy).
# DATABASE_URL=
# VITE_AUTH_ENABLED=false

# YubiCloud (optional; default public client id 1).
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
