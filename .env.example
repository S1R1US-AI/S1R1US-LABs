# DigitalOcean App Platform — Settings → web → Environment Variables → Edit → Add from .env
# Copy this file, fill secrets, then import. Never commit a filled .env.
# Encrypt BETTER_AUTH_SECRET and TWITTER_CLIENT_SECRET.
# Continue with X on s1r1us.ai uses native X OAuth 2.0 (not Grok Auth).
# Callback must be exactly: https://s1r1us.ai/api/auth/callback/twitter
# X app: 2097757193629995014  Keys and Tokens → OAuth 2.0 Client ID / Secret
# (not the user Access Token). No DATABASE_URL (PGLite).

NODE_ENV=production
VITE_AUTH_ENABLED=true
HOST=0.0.0.0
PORT=8080
NITRO_PRESET=node-server
BETTER_AUTH_URL=https://s1r1us.ai
BETTER_AUTH_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
